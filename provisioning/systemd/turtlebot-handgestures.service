[Unit]
Description=TurtleBot3 Hand Gestures Control System
After=network.target bluetooth.target
Wants=bluetooth.target

[Service]
Type=simple
User=turtlebot
Group=turtlebot
WorkingDirectory=/home/turtlebot/HandGestures2Bot
ExecStartPre=/bin/mkdir -p /tmp/turtlebot_logs
ExecStart=/bin/bash /home/turtlebot/HandGestures2Bot/start_boot.sh
ExecStop=/home/turtlebot/HandGestures2Bot/stop_robot.sh
Restart=on-failure
RestartSec=10
TimeoutStartSec=300

# Environment
Environment="HOME=/home/turtlebot"
Environment="USER=turtlebot"
Environment="ROS_DOMAIN_ID=0"
Environment="TURTLEBOT3_MODEL=burger"
Environment="LDS_MODEL=LDS-02"
Environment="PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin"

# Allow access to hardware
SupplementaryGroups=dialout video

# Logging to journal
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
